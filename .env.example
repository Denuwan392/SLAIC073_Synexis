# ==========================================
# SYNEXIS MONOREPO - ENVIRONMENT TEMPLATE
# ==========================================

# Required: Google Gemini AI API Key
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional: Gemini Model Configuration
GEMINI_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=models/text-embedding-004

# Optional: Vector DB Configuration
CHROMA_PERSIST_DIR=chroma_db

# Optional: Live Government Train Tracking Service URL
TRAIN_API_URL=http://localhost:4000/api/v1/trains

# Backend Web/App URL configuration
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=["*"]

# Server Port
PORT=8000
